# Copy to .env.local for local development.
#
# Where the marketing backend lives, WITHOUT /api/v1. The browser never calls it
# directly: next.config.ts rewrites /api/v1/* on this host to it, so the Better
# Auth session cookie is first-party to the admin host.
#
# Rewrites are compiled at BUILD time — changing this needs a rebuild
# (in Docker/Coolify pass it as a build argument).
BACKEND_URL=http://localhost:5000
