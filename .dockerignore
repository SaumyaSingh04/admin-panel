# dependencies and build output (rebuilt inside the image)
node_modules
**/node_modules
.next
out
build
coverage
*.tsbuildinfo
next-env.d.ts

# secrets: never send env files or keys into the build context
.env
.env.*
**/*.pem
**/*.key

# VCS, CI and editor metadata
.git
.github
.vscode
.idea

# docker files themselves
Dockerfile
.dockerignore
docker-compose*.yml

# docs and local assets not needed by the build
README.md
/*.png

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
